# Proof-to-Pay Environment Configuration Template
# Keep all credentials out of version control. Copy to .env for production deployment.

# GEMINI_API_KEY: Optional Gemini API key for automated project deliverable validation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production or preview URL of the platform.
APP_URL="https://prooftopay.in"

# SUPABASE PUBLIC CLIENT (Shared across Web and Native Android App)
# Note: NEVER put Supabase service-role key or database master password here.
# Enforce permissions strictly via database policies in /supabase/schema.sql.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# DATABASE_URL: PostgreSQL connection string (when connecting external database directly)
DATABASE_URL="postgresql://user:password@localhost:5432/prooftopay?schema=public"

# SESSION_SECRET: Secret for signing session cookies
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string"

# OBJECT_STORAGE: S3-compatible private object store configuration for deliverable archives
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
S3_BUCKET_NAME="proof-to-pay-deliverables-private"
S3_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="MY_AWS_SECRET_KEY"
S3_REGION="ap-south-1"

# PAYMENT_INTEGRATION: Indian payment gateway integration boundary (Disabled until KYC/legal clearance)
# Supported future providers: Razorpay / Cashfree / Decentro
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
